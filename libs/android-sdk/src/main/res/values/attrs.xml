<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TaleartView's XML attributes, as the <taleart-view> element's api-url and zone-key. -->
    <declare-styleable name="TaleartView">
        <attr name="taleartApiUrl" format="string" />
        <attr name="taleartZoneKey" format="string" />
        <!-- false turns this view's analytics events off, whatever the SDK's `analytics` option says. -->
        <attr name="taleartAnalytics" format="boolean" />
    </declare-styleable>
</resources>
