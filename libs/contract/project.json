{
  "name": "contract",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contract/src",
  "projectType": "library",
  "tags": [
    "type:contract"
  ],
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/openapi/openapi.yaml",
        "{projectRoot}/tale-document/**/*.json",
        "{projectRoot}/scripts/generate-tale-document-schemas.mjs",
        "{projectRoot}/scripts/tale-document-registry.mjs"
      ],
      "outputs": [
        "{projectRoot}/src/generated/api.ts",
        "{projectRoot}/src/generated/tale-document-schemas.ts"
      ],
      "options": {
        "commands": [
          "openapi-typescript libs/contract/openapi/openapi.yaml --enum-values -o libs/contract/src/generated/api.ts",
          "node libs/contract/scripts/generate-tale-document-schemas.mjs"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/contract",
        "main": "libs/contract/src/index.ts",
        "tsConfig": "libs/contract/tsconfig.lib.json",
        "assets": []
      },
      "dependsOn": [
        "generate"
      ]
    },
    "test": {
      "dependsOn": [
        "generate"
      ]
    }
  }
}
