{
  "name": "@taleart/contract",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./core": {
      "types": "./src/lib/core.d.ts",
      "default": "./src/lib/core.js"
    },
    "./project-fonts": {
      "types": "./src/lib/project-fonts.d.ts",
      "default": "./src/lib/project-fonts.js"
    },
    "./tale-document": {
      "types": "./src/lib/tale-document.d.ts",
      "default": "./src/lib/tale-document.js"
    },
    "./text-style": {
      "types": "./src/lib/text-style.d.ts",
      "default": "./src/lib/text-style.js"
    },
    "./theme": {
      "types": "./src/lib/theme.d.ts",
      "default": "./src/lib/theme.js"
    },
    "./openapi.json": {
      "types": "./src/openapi-json.d.ts",
      "default": "./src/generated/openapi.json"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
