{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": [
    "type:app",
    "scope:docs"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": [
        "^build",
        {
          "projects": [
            "contract"
          ],
          "target": "generate"
        }
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/libs/contract/openapi/openapi.yaml",
        "{workspaceRoot}/libs/contract/src/generated/openapi.json",
        "{workspaceRoot}/skills/taleart/**/*"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/docs",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/public"
          },
          {
            "glob": "openapi.json",
            "input": "libs/contract/src/generated",
            "output": "api-reference"
          },
          {
            "glob": "**/*.md",
            "input": "skills/taleart",
            "output": "skill/taleart"
          }
        ],
        "styles": [
          "apps/docs/src/styles.css"
        ],
        "server": "apps/docs/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "github-pages": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "/Taleart/",
          "outputPath": "dist/apps/docs-pages"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "build-pages": {
      "// note": "The docs for GitHub Pages (https://ido-lempert.github.io/Taleart/, .github/workflows/docs-pages.yml): the production build under the /Taleart/ base href in dist/apps/docs-pages/browser, with .nojekyll and 404.html (the prerendered not-found page).",
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "nx run docs:build:github-pages",
          "node apps/docs/scripts/finish-pages.mjs dist/apps/docs-pages/browser"
        ],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "proxyConfig": "apps/docs/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/libs/web-sdk/README.md",
        "{workspaceRoot}/apps/dashboard/src/app/**/*.html",
        "{workspaceRoot}/apps/dashboard/src/app/**/*.ts",
        "{workspaceRoot}/apps/api/src/app.spec.ts",
        "{workspaceRoot}/apps/docs/public/swagger-ui/*",
        "{workspaceRoot}/libs/contract/openapi/openapi.yaml",
        "{workspaceRoot}/libs/contract/src/generated/openapi.json",
        "{workspaceRoot}/skills/taleart/**/*"
      ],
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs:build",
        "port": 4300,
        "staticFilePath": "dist/apps/docs/browser",
        "spa": true
      }
    }
  },
  "implicitDependencies": [
    "api"
  ]
}
