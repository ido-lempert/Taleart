{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "docs",
  "sourceRoot": "apps/docs/src",
  "tags": [
    "type:app",
    "scope:docs"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": [
        "build-search-index",
        "^build",
        {
          "projects": [
            "contract"
          ],
          "target": "generate"
        },
        {
          "projects": [
            "web-sdk"
          ],
          "target": "build"
        }
      ],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/libs/contract/openapi/openapi.yaml",
        "{workspaceRoot}/libs/contract/src/generated/openapi.json",
        "{workspaceRoot}/libs/contract/src/generated/zone.schema.json",
        "{workspaceRoot}/libs/web-sdk/src/**/*",
        "{workspaceRoot}/skills/taleart/**/*"
      ],
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/docs",
        "browser": "apps/docs/src/main.ts",
        "tsConfig": "apps/docs/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/docs/public"
          },
          {
            "glob": "openapi.json",
            "input": "libs/contract/src/generated",
            "output": "api-reference"
          },
          {
            "glob": "*.js",
            "input": "dist/libs/web-sdk",
            "output": "sdk/web"
          },
          {
            "glob": "zone.schema.json",
            "input": "libs/contract/src/generated",
            "output": "schemas"
          },
          {
            "glob": "**/*.md",
            "input": "skills/taleart",
            "output": "skill/taleart"
          },
          {
            "glob": "search-index.json",
            "input": "dist/apps/docs-search"
          }
        ],
        "styles": [
          "apps/docs/src/styles.css"
        ],
        "server": "apps/docs/src/main.server.ts",
        "outputMode": "static"
      },
      "configurations": {
        "production": {
          "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "github-pages": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
          "outputHashing": "all",
          "baseHref": "/",
          "outputPath": "dist/apps/docs-pages"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "build-search-index": {
      "// note": "Builds search-index.json (the docs' search) from the page templates, before the build copies it into the site (build.assets). Reads DOCS_PAGES in app.routes.ts and the pages' inline templates; see scripts/build-search-index.mjs.",
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "node apps/docs/scripts/build-search-index.mjs dist/apps/docs-search/search-index.json"
      }
    },
    "build-pages": {
      "// note": "The docs for GitHub Pages (https://taleart.lempert.site/, .github/workflows/docs-pages.yml): the production build at the domain root (base href /) in dist/apps/docs-pages/browser, with .nojekyll and 404.html (the prerendered not-found page).",
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "commands": [
          "nx run docs:build:github-pages",
          "node apps/docs/scripts/finish-pages.mjs dist/apps/docs-pages/browser"
        ],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4300,
        "proxyConfig": "apps/docs/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "docs:build:production"
        },
        "development": {
          "buildTarget": "docs:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/libs/web-sdk/README.md",
        "{workspaceRoot}/apps/dashboard/src/app/**/*.html",
        "{workspaceRoot}/apps/dashboard/src/app/**/*.ts",
        "{workspaceRoot}/apps/api/src/app.spec.ts",
        "{workspaceRoot}/apps/docs/public/swagger-ui/*",
        "{workspaceRoot}/libs/contract/openapi/openapi.yaml",
        "{workspaceRoot}/libs/contract/src/generated/openapi.json",
        "{workspaceRoot}/skills/taleart/**/*"
      ],
      "options": {
        "watch": false
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "docs:build",
        "port": 4300,
        "staticFilePath": "dist/apps/docs/browser",
        "spa": true
      }
    }
  },
  "implicitDependencies": [
    "api"
  ]
}
