{
  "name": "sdk-sample",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/sdk-sample",
  "tags": ["type:app", "scope:sdk-sample"],
  "implicitDependencies": ["web-sdk"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["web-sdk"], "target": "build" }],
      "options": {
        "command": "node apps/sdk-sample/serve.mjs",
        "env": { "PORT": "4300" }
      }
    }
  }
}
