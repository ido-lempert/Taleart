{
  "name": "taller",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "tags": ["type:app", "scope:taller"],
  "targets": {
    "build-android": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew :taller-android:assembleDebug --console=plain"
      }
    },
    "build-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "xcodebuild -project apps/taller/iosApp/iosApp.xcodeproj -scheme iosApp -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -configuration Debug -derivedDataPath apps/taller/iosApp/build CODE_SIGNING_ALLOWED=NO build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew :taller:testAndroidHostTest --console=plain"
      }
    },
    "test-ios": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./gradlew :taller:iosSimulatorArm64Test --console=plain"
      }
    }
  }
}
