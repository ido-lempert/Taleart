{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@taleart/web-sdk": ["./libs/web-sdk/src/index.ts"],
      "@taleart/web-sdk/preview": ["./libs/web-sdk/src/preview.ts"],
      "@taleart/contract": ["./libs/contract/src/index.ts"],
      "@taleart/contract/core": ["./libs/contract/src/lib/core.ts"],
      "@taleart/contract/openapi.json": ["./libs/contract/src/generated/openapi.json"],
      "@taleart/contract/project-fonts": ["./libs/contract/src/lib/project-fonts.ts"],
      "@taleart/contract/tale-document": ["./libs/contract/src/lib/tale-document.ts"],
      "@taleart/contract/text-style": ["./libs/contract/src/lib/text-style.ts"],
      "@taleart/contract/theme": ["./libs/contract/src/lib/theme.ts"],
      "@taleart/agent-skill/*": ["./skills/taleart/*"],
      "@taleart/seed-demo": ["./libs/seed-demo/src/index.ts"],
      "@taleart/server-access": ["./libs/server/access/src/index.ts"],
      "@taleart/server-analytics": ["./libs/server/analytics/src/index.ts"],
      "@taleart/server-interactive": ["./libs/server/interactive/src/index.ts"],
      "@taleart/server-storage": ["./libs/server/storage/src/index.ts"],
      "@taleart/server-tales": ["./libs/server/tales/src/index.ts"],
      "@taleart/server-targeting": ["./libs/server/targeting/src/index.ts"],
      "@taleart/server-zones": ["./libs/server/zones/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
