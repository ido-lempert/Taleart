# TaleArt on Docker: configuration for docker-compose.yml. Copy to .env and edit:
#   cp .env.docker.example .env
#
# QUICK TRY: `docker compose --env-file .env.docker.example up -d --build` boots TaleArt on
# http://localhost:8080 with the placeholder values below. They are INSECURE and public: the database
# password, the secret key and the setup password are the ones everyone can read here. Use them only on
# your own machine, never on a server.

# --- Address (required) -----------------------------------------------------------------------------
# The exact address people open the dashboard at, no trailing slash. Set it once: the passkey domain
# (RP_ID), the passkey origin (RP_ORIGIN), the media/SDK public URL (PUBLIC_API_URL) and the host the
# dashboard accepts are all derived from it.
#   https://taleart.example.com   the bundled proxy gets and renews a Let's Encrypt certificate for the
#                                 name (point its DNS A/AAAA record at this server, open ports 80 and 443)
#   http://localhost:8080         plain HTTP, for trying it on your machine (passkeys work on localhost)
# Passkeys need https, or http on localhost. Plain http on another address cannot register a passkey.
TALEART_URL=http://localhost:8080

# Host ports of the bundled proxy. Use 80 and 443 on a server; the quick try uses 8080 and 8443.
TALEART_HTTP_PORT=8080
TALEART_HTTPS_PORT=8443

# --- Secrets (required) -----------------------------------------------------------------------------
# PostgreSQL password. There is no default: compose refuses to start without it. Letters and digits are
# safest (it goes into a connection URL). Generate: openssl rand -hex 24
# Changing it later does not change the existing database: only set it before the first `up`.
POSTGRES_PASSWORD=insecure-placeholder-change-me

# Encrypts the sign-in provider secrets (Google/Apple/OIDC client secrets) stored in the database:
# 32 random bytes, base64. Generate: openssl rand -base64 32
# Keep it: lose it and the saved provider secrets cannot be read. Left empty, the API runs but
# refuses to save provider secrets. This placeholder is public: replace it on a server.
TALEART_SECRET_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Optional ---------------------------------------------------------------------------------------
# true lets the first admin set up with a username and password instead of a passkey. Off by default;
# the quick try turns it on so the setup screen works without a passkey device.
TALEART_SETUP_PASSWORD=true

# Image tag for the images compose builds (taleart/api, taleart/dashboard). Pin a version when you
# publish or pull the images yourself.
TALEART_VERSION=local

# Proxies in front of the API: the number of hops X-Forwarded-For is trusted for (1 is the bundled
# proxy; 2 when your own proxy sits in front of it), or a list of addresses. Used for the rate limit.
TRUST_PROXY=1

# Delivery API rate limit per visitor: requests at once (0 turns it off) and per second. Empty: defaults.
DELIVERY_RATE_LIMIT_BURST=
DELIVERY_RATE_LIMIT_PER_SECOND=

# Database connections the API holds, and how many Web SDK builds stay at their pinned URLs (2 to 100).
DATABASE_POOL_MAX=20
SDK_BUILDS_KEPT=5

# With deploy/docker-compose.external-proxy.yml (your own reverse proxy): the loopback ports of the
# api and the dashboard.
TALEART_API_PORT=3333
TALEART_DASHBOARD_PORT=4000
