# TaleArt API configuration. Every variable is optional; the value shown is the default.

# PostgreSQL connection string for the API.
DATABASE_URL=postgres://taleart:taleart@localhost:5432/taleart

# Connections the API's pool holds. The import worker's media copies use at most this less 6 at once, so the
# dashboard's requests keep connections while an import runs.
DATABASE_POOL_MAX=20

# Port the API listens on.
PORT=3333

# The API's public origin (scheme, host and port). The Delivery API builds absolute public
# media URLs from it, such as http://localhost:3333/media/tales/<uuid>.png.
PUBLIC_API_URL=http://localhost:3333

# Folder for uploaded media, relative to where the API starts (the repo root under nx serve).
MEDIA_DIR=.data/media

# Folder where the API keeps the Web SDK builds it served, so pages that pin /sdk/v1/taleart.<hash>.js
# with Subresource Integrity keep working after the next SDK builds; relative to where the API starts
# (unset or empty: this default). It must persist across deploys (a volume, in a container), stay
# outside dist (a rebuild replaces dist), and be shared by every API process serving the same URLs, on
# hosts with synchronised clocks. In production the API warns at start when it holds no build.
# `off` (or false, none, no, 0, in any case) keeps only the current build.
SDK_BUILDS_DIR=.data/sdk-builds

# How many SDK builds stay at their pinned URLs, the current one included: 2 to 100 (an old and a new
# process each keep their build during a rolling deploy).
SDK_BUILDS_KEPT=5

# Passkey relying party ID: the dashboard's domain, without scheme or port.
RP_ID=localhost

# The dashboard's exact origin (scheme, host and port). Passkeys only verify from this origin;
# an https origin also makes the session cookie Secure. Invitation links point here too.
RP_ORIGIN=http://localhost:4200

# Key that encrypts a another tool API token while its import job is queued or running (AES-256-GCM):
# 32 random bytes, base64, e.g. from `openssl rand -base64 32`. Without it the import routes
# answer 503 importer_not_configured; the rest of the API works. No default.
IMPORT_TOKEN_KEY=

# The another tool External API the importer reads. Point it at the fake server for local reviews:
# http://127.0.0.1:4400/external (`nx run fake-another tool:serve`, token fake-another tool-token).
# The fake server reads FAKE_another tool_DELAY_MS (slow answers, to watch progress) and
# FAKE_another tool_FAIL=instances|story-groups|stories (that list answers 500, to see a failed run).
# FAKE_another tool_SCALE=1 also serves the Scale shop (1,000 stories with media, latency and occasional
# 429/500 replies; 0.1 runs it ten times faster). `nx run api:import-scale` measures its import.
another tool_API_URL=https://api.another tool.io/external

# The importer copies each tale's media from the URL the source names, and fetches only public
# addresses (never private, loopback, link-local or metadata ones, also after redirects). For local
# reviews against the fake server only, exempt its exact endpoint: 127.0.0.1:4400. Leave it empty in
# production.
IMPORT_MEDIA_ALLOWED_ADDRESSES=

# Media one import may copy in all: bytes (default 5368709120, 5 GB) and seconds (default 3600).
# Media past either budget is listed in the report as not imported. Downloads run several at once, so
# the seconds are wall-clock time for the import's media as a whole.
IMPORT_MEDIA_MAX_BYTES_PER_JOB=
IMPORT_MEDIA_MAX_SECONDS_PER_JOB=

# Node environment. `development` or `test` allow TALE_TEST_ELEMENT_TYPES=on; production deployments set
# `production` (or leave it unset).
NODE_ENV=

# Tests and development only (epic Tale Studio R8): `on` accepts the element-type registry's test-only
# types (`testOnly` in libs/contract/tale-document/element-types/registry.json) in tale documents. With
# any NODE_ENV but `development` or `test`, `on` stops the API at start. The dashboard offers them only in
# a development build with localStorage `taleart.testElementTypes` set to `on`.
TALE_TEST_ELEMENT_TYPES=off

# Integration tests only: a database whose name ends in _test (the tests clear its tables).
TEST_DATABASE_URL=postgres://taleart:taleart@localhost:5432/taleart_test
